# Copy to .env.production on the server and replace every placeholder.
APP_PORT=8080
BACKEND_MEMORY_LIMIT=768m

DB_NAME=meet
DB_USERNAME=meet
DB_PASSWORD=

# Generate with: openssl rand -base64 48
APP_JWT_SECRET=CHANGE_ME

# Public HTTPS URL exposed by the reverse proxy.
# Example: https://api.your-domain.example/media
APP_STORAGE_BASE_URL=

# Leave blank to disable /admin/**.
ADMIN_API_KEY=

# Authentication delivery is intentionally unavailable until email OTP is implemented.
APP_SMS_PROVIDER=disabled

# Scheduled outbound integrations are opt-in in the prod profile.
INGESTION_ENABLED=false
GEOCODER_ENABLED=false
TIMEPAD_ENABLED=false
LOCATIONIQ_KEY=
TIMEPAD_TOKEN=

# API docs are disabled in prod by default.
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
