# First install only: initialize .env.production from this template.
# Never copy this file over an existing production environment.
APP_PORT=8080
BACKEND_MEMORY_LIMIT=768m
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# Required immutable release identity. Use the full 40-character Git SHA and a
# unique, non-reused image tag (or registry digest) built from that exact SHA.
BACKEND_REVISION=
BACKEND_IMAGE=

# These values initialize PostgreSQL only when postgres_data is empty. Changing
# them later does not update the existing database role; follow the rotation
# procedure in docs/production-deployment.md.
DB_NAME=meet
DB_USERNAME=meet
DB_PASSWORD=

# Generate with: openssl rand -base64 48
APP_JWT_SECRET=CHANGE_ME

# Public HTTPS URL exposed by the reverse proxy.
# Example: https://api.your-domain.example/media
APP_STORAGE_BASE_URL=

# Leave blank to disable /admin/**.
ADMIN_API_KEY=

# Email OTP is the production authentication provider. Replace every SMTP and
# key-ring placeholder with operator-managed values; never commit them.
APP_EMAIL_PROVIDER=smtp
APP_EMAIL_FROM=no-reply@example.com
APP_EMAIL_FROM_NAME=Meet
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace-with-smtp-username
SPRING_MAIL_PASSWORD=replace-with-smtp-password
APP_EMAIL_CONNECT_TIMEOUT_MS=5000
APP_EMAIL_READ_TIMEOUT_MS=5000
APP_EMAIL_WRITE_TIMEOUT_MS=5000
APP_OTP_HMAC_CURRENT_KEY_ID=replace-with-current-key-id
APP_OTP_HMAC_CURRENT_KEY_BASE64=replace-with-32-byte-base64-key
APP_OTP_HMAC_PREVIOUS_KEY_ID=
APP_OTP_HMAC_PREVIOUS_KEY_BASE64=

# SMS remains intentionally disabled; phone OTP is not a production delivery
# path until an operator-approved SMS provider is added separately.
APP_SMS_PROVIDER=disabled

# Scheduled outbound integrations are opt-in in the prod profile.
INGESTION_ENABLED=false
GEOCODER_ENABLED=false
TIMEPAD_ENABLED=false
LOCATIONIQ_KEY=
TIMEPAD_TOKEN=

# API docs are disabled in prod by default.
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
