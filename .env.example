APP_SMS_PROVIDER=disabled
# Production must use smtp. Keep these commented for the dev fake sender.
# APP_EMAIL_PROVIDER=smtp
# APP_EMAIL_FROM=no-reply@example.com
# APP_EMAIL_FROM_NAME=Meet
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=<secret-manager-injected>
# SPRING_MAIL_PASSWORD=<secret-manager-injected>
# APP_EMAIL_CONNECT_TIMEOUT_MS=5000
# APP_EMAIL_READ_TIMEOUT_MS=5000
# APP_EMAIL_WRITE_TIMEOUT_MS=5000

# Generate at least 32 random bytes and Base64-encode them. Never reuse JWT,
# database, SMTP, dev, or test secrets. Previous values are used only during rotation.
# APP_OTP_HMAC_CURRENT_KEY_ID=<safe-key-id>
# APP_OTP_HMAC_CURRENT_KEY_BASE64=<secret-manager-injected>
# APP_OTP_HMAC_PREVIOUS_KEY_ID=
# APP_OTP_HMAC_PREVIOUS_KEY_BASE64=

# Comma-separated proxy CIDRs. Leave empty unless every listed proxy is controlled.
# APP_HTTP_CLIENT_IP_TRUSTED_PROXY_CIDRS=
# APP_HTTP_CLIENT_IP_MAX_FORWARDED_HOPS=10

# Optional OTP policy overrides.
# APP_OTP_EXPIRATION_MINUTES=5
# APP_OTP_MAX_ATTEMPTS_PER_HOUR=5
# APP_OTP_CHALLENGE_RETENTION_HOURS=24
# APP_OTP_CHALLENGE_CLEANUP_BATCH_SIZE=1000
# APP_OTP_CHALLENGE_CLEANUP_DELAY_MS=600000
# APP_OTP_IP_MAX_ATTEMPTS=20
# APP_OTP_DEVICE_LIMIT_ENABLED=false
# APP_OTP_DEVICE_MAX_ATTEMPTS=10
# APP_OTP_RATE_LIMIT_CLEANUP_BATCH_SIZE=1000
# APP_OTP_RATE_LIMIT_CLEANUP_DELAY_MS=600000
# APP_OTP_VERIFICATION_WINDOW_MINUTES=15
# APP_OTP_VERIFICATION_IDENTIFIER_MAX_ATTEMPTS=5
# APP_OTP_VERIFICATION_IP_MAX_ATTEMPTS=50
# APP_OTP_VERIFICATION_DEVICE_MAX_ATTEMPTS=10
# Local development database values for docker-compose.yml.
DB_NAME=meet_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Optional: set a nonblank value to enable /admin/** endpoints.
# ADMIN_API_KEY=
